{
  "name": "linkedin-purge",
  "version": "0.5.10",
  "description": "Purge your own LinkedIn comments and likes via Playwright with randomized pacing.",
  "license": "MIT",
  "private": true,
  "bin": {
    "linkedin-purge": "src/cli.mjs"
  },
  "scripts": {
    "login": "node src/cli.mjs login",
    "login-import-profile": "node src/cli.mjs login-import-profile",
    "scan": "node src/cli.mjs scan",
    "purge": "node src/cli.mjs purge",
    "status": "node src/cli.mjs status",
    "help": "node src/cli.mjs --help",
    "verify:page": "node scripts/verify-page.mjs",
    "verify:selection-page": "node scripts/selection-page-browser-check.mjs",
    "check": "node scripts/check-all.mjs && node scripts/check-comments.mjs && node scripts/test-runner.mjs",
    "check-changelog": "node scripts/check-changelog.mjs",
    "fix:comments": "node scripts/fix-comments.mjs",
    "fix:slop": "node scripts/fix-slop.mjs",
    "check:slop": "node scripts/fix-slop.mjs --check",
    "health": "node scripts/health.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node scripts/test-runner.mjs",
    "postinstall": "echo 'No build step needed'",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{js,mjs,cjs,jsx,tsx,ts}\" \"tests/**/*.{js,mjs,cjs,jsx,tsx,ts}\" \"scripts/*.mjs\" \"*.js\""
  },
  "dependencies": {
    "audit": "^0.0.6",
    "fix": "^0.0.3",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.7.0",
    "puppeteer-extra-plugin-user-preferences": "^2.4.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.90.0",
    "espree": "^11.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10"
  }
}
