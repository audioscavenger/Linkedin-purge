{
  "name": "linkedin-purge",
  "version": "0.5.6",
  "description": "Purge your own LinkedIn comments and likes via Playwright with randomized pacing.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "linkedin-purge": "src/cli.js"
  },
  "scripts": {
    "login": "node src/cli.js login",
    "login-import-profile": "node src/cli.js login-import-profile",
    "scan": "node src/cli.js scan",
    "purge": "node src/cli.js purge",
    "status": "node src/cli.js status",
    "help": "node src/cli.js --help",
    "verify:page": "node scripts/verify-page.js",
    "verify:selection-page": "node scripts/selection-page-browser-check.js",
    "check": "node scripts/check-all.js && node scripts/check-comments.js && node scripts/test-runner.js",
    "check-changelog": "node scripts/check-changelog.js",
    "fix:comments": "node scripts/fix-comments.js",
    "health": "node scripts/health.js",
    "lint": "eslint .",
    "test": "node scripts/test-runner.js",
    "postinstall": "echo 'No build step needed'",
    "prepare": "husky"
  },
  "dependencies": {
    "audit": "^0.0.6",
    "fix": "^0.0.3",
    "playwright": "^1.65.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
