{
  "name": "linkedin-purge",
  "version": "0.3.1",
  "description": "Purge your own LinkedIn comments and likes via Playwright with randomized pacing.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "linkedin-purge": "src/cli.js"
  },
  "scripts": {
    "login": "node src/cli.js login",
    "copy-chromium-profile": "node src/cli.js copy-chromium-profile",
    "scan": "node src/cli.js scan",
    "purge": "node src/cli.js purge",
    "status": "node src/cli.js status",
    "help": "node src/cli.js --help",
    "check": "node scripts/check-all.js && node tests/purge.test.js",
    "health": "node scripts/health.js",
    "lint": "echo 'No linter configured; running full check' && npm run check",
    "test": "node tests/purge.test.js",
    "postinstall": "echo 'No build step needed'",
    "prepare": "husky"
  },
  "dependencies": {
    "playwright": "^1.52.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "husky": "^9.0.0"
  }
}
